(define (reverse-iter xs ys)
  (if (null? xs)
      ys
      (reverse-iter (cdr xs) (cons (car xs) ys))))

(define (reverse xs)
  (reverse-iter xs '()))

(define (form-trace trace)
  (cons 'begin (reverse trace)))

(define (lambda? op)
  (and (pair? op) (eq? lambda-tag (car op))))

(define eval-jit-trace
  (lambda (exp env cont)
    (let ((original-base-eval base-eval)
          (original-eval-application eval-application)
          (original-base-apply base-apply)
          (original-eval-set! eval-set!)
          (original-eval-if eval-if)
          (trace '())
          (count 0)
          (stack '()))
      (define (add-trace! exp)
        (display (list 'trace exp))
        (newline)
        (set! trace (cons exp trace)))
      (define (gen-id!)
        (let ((id count))
          (set! count (+ 1 count))
          (list 'a id)))
      (define (anf-in! exp)
        (if (null? exp)
            '()
            (cons (pop-stack!) (anf-in! (cdr exp)))))
      (define (anf! exp)
        (let ((r (cons (car exp) (reverse (anf-in! (cdr exp))))))
          (pop-stack!)
          r))
      (define (pop-stack!)
        (let ((exp (car stack)))
          (set! stack (cdr stack))
          exp))
      (define (push-stack-entry! e)
        (display (list 'stack 'push e stack))
        (set! stack (cons e stack)))
      (define (push-stack! exp v)
        (push-stack-entry!
         (if (pair? exp)
             (let ((id (gen-id!)))
               (add-trace! (list 'define id (anf! exp)))
               id)
             exp)))
      (set! base-eval
        (lambda (exp env cont)
          (original-base-eval
           exp env
           (lambda (v)
             (if (not (pair? exp))
                 (push-stack! exp v))
             (cont v)))))
      (set! eval-application
        (lambda (exp env cont)
          (original-eval-application
           exp env
           (lambda (ov)
             (let ((o (car ov))
                   (v (car (cdr ov))))
               (if (not (lambda? o))
                   (push-stack! exp v)
                   (begin
                     (display (list 'stack 'before stack))
                     (newline)
                     (anf! exp)
                     (display (list 'stack 'after stack))
                     (newline)))
               (cont v))))))
      (set! base-apply
        (lambda (operator operand env cont)
          (original-base-apply
           operator operand env
           (lambda (v)
             (cont (list operator v))))))
      (set! eval-set!
        (lambda (exp env cont)
          (original-eval-set!
           exp env
           (lambda (v)
             (add-trace! (list 'set! (car (cdr exp)) (pop-stack!)))
             (push-stack-entry! 'undefined)
             (cont v)))))
      (set! eval-if
        (lambda (exp env cont)
          (let ((pred-part (car (cdr exp)))
                (then-part (car (cdr (cdr exp))))
                (else-part (cdr (cdr (cdr exp)))))
            (base-eval
             pred-part env
             (lambda (p)
               (if p
                   (begin
                     (add-trace! (list 'speculate (pop-stack!)))
                     (base-eval then-part env cont))
                   (begin
                     (add-trace! (list 'speculate (list 'not (pop-stack!))))
                     (if (null? else-part)
                         (cont #f)
                         (base-eval (car else-part) env cont)))))))))
      (base-eval
       exp env
       (lambda (ans)
         (set! base-eval original-base-eval)
         (set! eval-application original-eval-application)
         (set! base-apply original-base-apply)
         (set! eval-set! original-eval-set!)
         (set! eval-if original-eval-if)
         (add-trace! (pop-stack!))
         (display stack)
         (newline)
         (cont (form-trace trace)))))))

(add-app-hook!
 'jit-trace
 (lambda (exp env cont)
   ((eval-jit-trace (car (cdr exp)) env cont))))
