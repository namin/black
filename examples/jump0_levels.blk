;; at user level
(begin
  (EM (define re-enter #f))
  ((delta (e r k) (set! re-enter k))))

;; at each meta-level
(begin
  (EM (define re-enter #f))
  ((delta (e r k)
     (set! re-enter
       (lambda (v)
         (base-eval
          're-enter r
          (lambda (re-enter)
            (k (re-enter v)))))))))

