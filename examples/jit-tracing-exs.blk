(EM (load "examples/utils.blk"))
(EM (load "examples/jit-tracing.blk"))
(define x 2)
(jit-trace (+ 1 (if (> x 4) 2 3)))
(jit-trace (+ 1 (if (> x 4) 2 (if (< x 2) 5 3))))
(define x 3)
(jit-trace (begin (if (> x 3) (set! x 3) (set! x 0))))
(jit-trace (begin (if (> x 3) (set! x 3))))
(jit-trace (+ 1 (+ 2 (+ 3 4) (+ 5 6))))
(set! x 4)
(define (foo)
  (if (< x 0)
      (set! x 0)
      (begin
        (set! x (- x 1))
        (foo))))
(jit-trace (foo))
(define (bar x)
  (if (< x 0)
      10
      (+ 2 (bar (- x 1)))))
;; does not work
(jit-trace (bar 0))
;; TODO: need to do or
(define (bar x)
  (if (or (= x 0) (< x 0))
      0
      (+ 2 (bar (- x 1)))))
